# ==============================================================================
# ZCROSS PRODUCTION MAINNET CONFIGURATION & ROADMAP ENVIRONMENT MATRIX
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ZCASH NODE & LIGHTWALLETD CONSENSUS
# ------------------------------------------------------------------------------
# Connect to a live lightwalletd gRPC cluster or local Zebra/zcashd node
ZCASH_NODE_URL=https://mainnet.lightwalletd.com:9067
ZCASH_NETWORK=mainnet
# Optional RPC credentials if querying local Zebra/zcashd directly
# ZCASH_RPC_USER=
# ZCASH_RPC_PASSWORD=

# ------------------------------------------------------------------------------
# 2. NEAR INTENTS & DEFUSE PROTOCOL SOLVER VAULT
# ------------------------------------------------------------------------------
# Get your JWT / API key from https://partners.near-intents.org/home
NEAR_INTENTS_API_KEY=
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com

# Production Defuse Protocol Solver Vault (Registered on NEAR mainnet)
DEFUSE_SOLVER_ACCOUNT_ID=solver-vault.near
DEFUSE_CONTRACT_ID=intents.near
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_NETWORK=mainnet

# ------------------------------------------------------------------------------
# 3. GOOGLE PAY LIVE RAILS & GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Acquired via Google Pay & Wallet Business Console (https://pay.google.com/business/console)
GOOGLE_PAY_ENVIRONMENT=PRODUCTION
GOOGLE_PAY_MERCHANT_ID=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=ZCross Shielded Payments
GOOGLE_PAY_GATEWAY=stripe
GOOGLE_PAY_WEBHOOK_SECRET=

# Gateway Configuration (Select active gateway in GOOGLE_PAY_GATEWAY)
# Stripe
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Braintree
BRAINTREE_MERCHANT_ID=
BRAINTREE_CLIENT_KEY=

# Multi-Provider Fiat Aggregators (MoonPay, Transak, Ramp)
NEXT_PUBLIC_MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_WEBHOOK_SECRET=
NEXT_PUBLIC_RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE (POSTGRESQL & UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Production PostgreSQL (Supabase, Neon, or AWS RDS). Defaults to SQLite if unset.
# DATABASE_URL=postgresql://user:password@aws-rds-cluster.supabase.co:5432/zcross

# Distributed Edge Rate Limiting & Idempotency (Upstash Redis REST API)
# UPSTASH_REDIS_REST_URL=https://upstash-cluster-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 5. PRODUCTION DOMAIN & SSL
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://zcross.cash

# ------------------------------------------------------------------------------
# 6. SECURITY AUDIT & KEY MANAGEMENT (AWS KMS / HASHICORP VAULT)
# ------------------------------------------------------------------------------
# Key Management Provider: ENV | AWS_SECRETS_MANAGER | HASHICORP_VAULT
SECRETS_PROVIDER=ENV

# AWS KMS Configuration (Used for server relayer envelope encryption)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/example-relayer-key
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# HashiCorp Vault Configuration
# VAULT_ADDR=https://vault.internal.network:8200
# VAULT_TOKEN=
# VAULT_PATH=secret/data/zcross
# VAULT_NAMESPACE=
